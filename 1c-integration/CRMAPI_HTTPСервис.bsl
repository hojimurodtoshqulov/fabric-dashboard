// ============================================================
// МОДУЛЬ HTTP СЕРВИСА: CRMAPI
// Корневой URL: /crm
// Все обработчики — серверные, не требуют сеанса пользователя
// ============================================================

// ============================================================
// ЭНДПОИНТ 1: GET /v1/clients
// Шаблон URL: /v1/clients
// ============================================================

Функция КлиентыПолучить(Запрос) Экспорт

    Если НЕ CRMАПИСервер.ПроверитьАвторизацию(Запрос) Тогда
        Возврат CRMАПИСервер.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    Страница       = CRMАПИСервер.ПолучитьЧисловойПараметр(Запрос, "page",  1,   1, 10000);
    Лимит          = CRMАПИСервер.ПолучитьЧисловойПараметр(Запрос, "limit", 50,  1, 200);
    ТекстПоиска    = CRMАПИСервер.ПолучитьПараметр(Запрос, "search", "");
    ОбновленПосле  = CRMАПИСервер.ПолучитьПараметр(Запрос, "updated_after", "");
    ДатаОбновления = CRMАПИСервер.ПарситьДату(ОбновленПосле);

    Смещение = (Страница - 1) * Лимит;

    // Запрос общего количества
    ЗапросКол = Новый Запрос;
    ЗапросКол.Текст =
        "ВЫБРАТЬ
        |    КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Контрагенты.Ссылка) КАК Количество
        |ИЗ
        |    Справочник.Контрагенты КАК Контрагенты
        |ГДЕ
        |    НЕ Контрагенты.ПометкаУдаления
        |    И НЕ Контрагенты.ЭтоГруппа
        |" + ?(ЗначениеЗаполнено(ТекстПоиска),
              "И (Контрагенты.Наименование ПОДОБНО &Поиск
        |       ИЛИ Контрагенты.ИНН ПОДОБНО &Поиск)
        |", "")
          + ?(ЗначениеЗаполнено(ДатаОбновления) И ДатаОбновления <> '00010101',
              "И Контрагенты.Дата >= &ДатаОбновления
        |", "");

    Если ЗначениеЗаполнено(ТекстПоиска) Тогда
        ЗапросКол.УстановитьПараметр("Поиск", "%" + ТекстПоиска + "%");
    КонецЕсли;
    Если ЗначениеЗаполнено(ДатаОбновления) И ДатаОбновления <> '00010101' Тогда
        ЗапросКол.УстановитьПараметр("ДатаОбновления", ДатаОбновления);
    КонецЕсли;

    ВыборкаКол = ЗапросКол.Выполнить().Выбрать();
    ВыборкаКол.Следующий();
    Всего = ВыборкаКол.Количество;

    // Основной запрос с данными
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
        |    Контрагенты.Ссылка         КАК Ссылка,
        |    Контрагенты.Наименование   КАК Наименование,
        |    Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
        |    Контрагенты.ИНН            КАК ИНН,
        |    Контрагенты.КПП            КАК КПП,
        |    Контрагенты.Дата           КАК ДатаРегистрации,
        |    КонтТелефон.Представление  КАК Телефон,
        |    КонтАдрес.Представление    КАК Адрес
        |ИЗ
        |    Справочник.Контрагенты КАК Контрагенты
        |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтТелефон
        |            ПО КонтТелефон.Объект = Контрагенты.Ссылка
        |            И КонтТелефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
        |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтАдрес
        |            ПО КонтАдрес.Объект = Контрагенты.Ссылка
        |            И КонтАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
        |ГДЕ
        |    НЕ Контрагенты.ПометкаУдаления
        |    И НЕ Контрагенты.ЭтоГруппа
        |" + ?(ЗначениеЗаполнено(ТекстПоиска),
              "И (Контрагенты.Наименование ПОДОБНО &Поиск
        |       ИЛИ Контрагенты.ИНН ПОДОБНО &Поиск)
        |", "")
          + ?(ЗначениеЗаполнено(ДатаОбновления) И ДатаОбновления <> '00010101',
              "И Контрагенты.Дата >= &ДатаОбновления
        |", "")
          + "УПОРЯДОЧИТЬ ПО
        |    Контрагенты.Наименование
        |ПРОПУСТИТЬ " + Формат(Смещение, "ЧГ=0");

    Если ЗначениеЗаполнено(ТекстПоиска) Тогда
        Запрос.УстановитьПараметр("Поиск", "%" + ТекстПоиска + "%");
    КонецЕсли;
    Если ЗначениеЗаполнено(ДатаОбновления) И ДатаОбновления <> '00010101' Тогда
        Запрос.УстановитьПараметр("ДатаОбновления", ДатаОбновления);
    КонецЕсли;

    Выборка = Запрос.Выполнить().Выбрать();

    ЗJ = CRMАПИСервер.НачатьОтветJSON();
    ЗJ.ЗаписатьИмяСвойства("data");
    ЗJ.ЗаписатьНачалоМассива();

    Пока Выборка.Следующий() Цикл

        ЗJ.ЗаписатьНачалоОбъекта();

        ЗJ.ЗаписатьИмяСвойства("id");
        ЗJ.ЗаписатьЗначение(CRMАПИСервер.ФорматГУИД(Выборка.Ссылка));

        ЗJ.ЗаписатьИмяСвойства("company_name");
        ЗJ.ЗаписатьЗначение(Выборка.НаименованиеПолное);

        ЗJ.ЗаписатьИмяСвойства("short_name");
        ЗJ.ЗаписатьЗначение(Выборка.Наименование);

        ЗJ.ЗаписатьИмяСвойства("inn");
        ЗJ.ЗаписатьЗначение(Выборка.ИНН);

        ЗJ.ЗаписатьИмяСвойства("kpp");
        ЗJ.ЗаписатьЗначение(Выборка.КПП);

        ЗJ.ЗаписатьИмяСвойства("phone");
        Если ЗначениеЗаполнено(Выборка.Телефон) Тогда
            ЗJ.ЗаписатьЗначение(Выборка.Телефон);
        Иначе
            ЗJ.ЗаписатьЗначение(Неопределено);
        КонецЕсли;

        ЗJ.ЗаписатьИмяСвойства("address");
        Если ЗначениеЗаполнено(Выборка.Адрес) Тогда
            ЗJ.ЗаписатьЗначение(Выборка.Адрес);
        Иначе
            ЗJ.ЗаписатьЗначение(Неопределено);
        КонецЕсли;

        ЗJ.ЗаписатьИмяСвойства("created_at");
        CRMАПИСервер.ЗаписатьДату(ЗJ, Выборка.ДатаРегистрации);

        ЗJ.ЗаписатьИмяСвойства("updated_at");
        CRMАПИСервер.ЗаписатьДату(ЗJ, Выборка.ДатаРегистрации);

        ЗJ.ЗаписатьКонецОбъекта();

    КонецЦикла;

    ЗJ.ЗаписатьКонецМассива();
    CRMАПИСервер.ЗаписатьПагинацию(ЗJ, Страница, Лимит, Всего);

    Возврат CRMАПИСервер.ОтветУспех(CRMАПИСервер.ЗакрытьОтветJSON(ЗJ));

КонецФункции

// ============================================================
// ЭНДПОИНТ 2: GET /v1/contracts
// Шаблон URL: /v1/contracts
// ============================================================

Функция ДоговорыПолучить(Запрос) Экспорт

    Если НЕ CRMАПИСервер.ПроверитьАвторизацию(Запрос) Тогда
        Возврат CRMАПИСервер.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    Страница      = CRMАПИСервер.ПолучитьЧисловойПараметр(Запрос, "page",  1,  1, 10000);
    Лимит         = CRMАПИСервер.ПолучитьЧисловойПараметр(Запрос, "limit", 50, 1, 200);
    КлиентИДСтр   = CRMАПИСервер.ПолучитьПараметр(Запрос, "client_id", "");
    ТолькоАктивные = CRMАПИСервер.ПолучитьБулевоПараметр(Запрос, "active_only", Ложь);

    КлиентСсылка = CRMАПИСервер.ГУИДВСсылкуКонтрагента(КлиентИДСтр);
    Смещение = (Страница - 1) * Лимит;
    Сегодня  = НачалоДня(ТекущаяДата());

    // Строим условие WHERE
    УслКлиент  = ?(ЗначениеЗаполнено(КлиентСсылка), "И Договоры.Владелец = &Клиент" + Символы.ПС, "");
    УслАктивные = ?(ТолькоАктивные,
        "И (Договоры.СрокДействия = &ПустаяДата ИЛИ Договоры.СрокДействия >= &Сегодня)" + Символы.ПС, "");

    // Запрос количества
    ЗапросКол = Новый Запрос;
    ЗапросКол.Текст =
        "ВЫБРАТЬ КОЛИЧЕСТВО(Договоры.Ссылка) КАК Количество
        |ИЗ Справочник.ДоговорыКонтрагентов КАК Договоры
        |ГДЕ НЕ Договоры.ПометкаУдаления
        |    И НЕ Договоры.ЭтоГруппа
        |" + УслКлиент + УслАктивные;

    ЗапросКол.УстановитьПараметр("ПустаяДата", '00010101');
    ЗапросКол.УстановитьПараметр("Сегодня", Сегодня);
    Если ЗначениеЗаполнено(КлиентСсылка) Тогда
        ЗапросКол.УстановитьПараметр("Клиент", КлиентСсылка);
    КонецЕсли;

    ВыборкаКол = ЗапросКол.Выполнить().Выбрать();
    ВыборкаКол.Следующий();
    Всего = ВыборкаКол.Количество;

    // Основной запрос
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
        |    Договоры.Ссылка             КАК Ссылка,
        |    Договоры.Владелец           КАК Клиент,
        |    Договоры.Номер              КАК Номер,
        |    Договоры.ВидДоговора        КАК ВидДоговора,
        |    Договоры.Дата               КАК ДатаНачала,
        |    Договоры.СрокДействия       КАК СрокДействия,
        |    Договоры.ВалютаВзаиморасчетов КАК Валюта
        |ИЗ
        |    Справочник.ДоговорыКонтрагентов КАК Договоры
        |ГДЕ
        |    НЕ Договоры.ПометкаУдаления
        |    И НЕ Договоры.ЭтоГруппа
        |" + УслКлиент + УслАктивные
          + "УПОРЯДОЧИТЬ ПО Договоры.Дата УБЫВ
        |ПРОПУСТИТЬ " + Формат(Смещение, "ЧГ=0");

    Запрос.УстановитьПараметр("ПустаяДата", '00010101');
    Запрос.УстановитьПараметр("Сегодня", Сегодня);
    Если ЗначениеЗаполнено(КлиентСсылка) Тогда
        Запрос.УстановитьПараметр("Клиент", КлиентСсылка);
    КонецЕсли;

    Выборка = Запрос.Выполнить().Выбрать();

    ЗJ = CRMАПИСервер.НачатьОтветJSON();
    ЗJ.ЗаписатьИмяСвойства("data");
    ЗJ.ЗаписатьНачалоМассива();

    Пока Выборка.Следующий() Цикл

        // Вычисляем статус договора
        Если ЗначениеЗаполнено(Выборка.СрокДействия) И Выборка.СрокДействия <> '00010101' Тогда
            Статус = ?(НачалоДня(Выборка.СрокДействия) >= Сегодня, "active", "expired");
        Иначе
            Статус = "active"; // бессрочный
        КонецЕсли;

        ЗJ.ЗаписатьНачалоОбъекта();

        ЗJ.ЗаписатьИмяСвойства("contract_id");
        ЗJ.ЗаписатьЗначение(CRMАПИСервер.ФорматГУИД(Выборка.Ссылка));

        ЗJ.ЗаписатьИмяСвойства("client_id");
        CRMАПИСервер.ЗаписатьГУИД(ЗJ, Выборка.Клиент);

        ЗJ.ЗаписатьИмяСвойства("contract_number");
        ЗJ.ЗаписатьЗначение(Выборка.Номер);

        ЗJ.ЗаписатьИмяСвойства("contract_type");
        ЗJ.ЗаписатьЗначение(Строка(Выборка.ВидДоговора));

        ЗJ.ЗаписатьИмяСвойства("start_date");
        CRMАПИСервер.ЗаписатьДату(ЗJ, Выборка.ДатаНачала);

        ЗJ.ЗаписатьИмяСвойства("end_date");
        CRMАПИСервер.ЗаписатьДату(ЗJ, Выборка.СрокДействия);

        ЗJ.ЗаписатьИмяСвойства("currency");
        ЗJ.ЗаписатьЗначение(Строка(Выборка.Валюта));

        ЗJ.ЗаписатьИмяСвойства("status");
        ЗJ.ЗаписатьЗначение(Статус);

        ЗJ.ЗаписатьКонецОбъекта();

    КонецЦикла;

    ЗJ.ЗаписатьКонецМассива();
    CRMАПИСервер.ЗаписатьПагинацию(ЗJ, Страница, Лимит, Всего);

    Возврат CRMАПИСервер.ОтветУспех(CRMАПИСервер.ЗакрытьОтветJSON(ЗJ));

КонецФункции

// ============================================================
// ЭНДПОИНТ 3: GET /v1/invoices
// Шаблон URL: /v1/invoices
// ============================================================

Функция СчетаФактурыПолучить(Запрос) Экспорт

    Если НЕ CRMАПИСервер.ПроверитьАвторизацию(Запрос) Тогда
        Возврат CRMАПИСервер.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    Страница      = CRMАПИСервер.ПолучитьЧисловойПараметр(Запрос, "page",  1,  1, 10000);
    Лимит         = CRMАПИСервер.ПолучитьЧисловойПараметр(Запрос, "limit", 50, 1, 200);
    КлиентИДСтр   = CRMАПИСервер.ПолучитьПараметр(Запрос, "client_id", "");
    ДатаОтСтр     = CRMАПИСервер.ПолучитьПараметр(Запрос, "date_from", "");
    ДатаДоСтр     = CRMАПИСервер.ПолучитьПараметр(Запрос, "date_to", "");
    ТолькоНеоплач = CRMАПИСервер.ПолучитьБулевоПараметр(Запрос, "unpaid_only", Ложь);

    КлиентСсылка = CRMАПИСервер.ГУИДВСсылкуКонтрагента(КлиентИДСтр);
    ДатаОт = CRMАПИСервер.ПарситьДату(ДатаОтСтр);
    ДатаДо = CRMАПИСервер.ПарситьДату(ДатаДоСтр);
    Смещение = (Страница - 1) * Лимит;
    Сегодня  = НачалоДня(ТекущаяДата());

    УслКлиент = ?(ЗначениеЗаполнено(КлиентСсылка),   "И СФ.Контрагент = &Клиент" + Символы.ПС, "");
    УслДатаОт = ?(ЗначениеЗаполнено(ДатаОт) И ДатаОт <> '00010101', "И СФ.Дата >= &ДатаОт" + Символы.ПС, "");
    УслДатаДо = ?(ЗначениеЗаполнено(ДатаДо) И ДатаДо <> '00010101', "И СФ.Дата <= &ДатаДо" + Символы.ПС, "");
    // Для фильтра неоплаченных используем СрокОплаты < сегодня или нет данных
    // (точный расчёт paid_amount — в эндпоинте /debts через агрегацию платежей)
    УслНеоплач = ?(ТолькоНеоплач, "И (СФ.СрокОплаты = &ПустаяДата ИЛИ СФ.СрокОплаты >= &Сегодня)" + Символы.ПС, "");

    // Запрос количества
    ЗапросКол = Новый Запрос;
    ЗапросКол.Текст =
        "ВЫБРАТЬ КОЛИЧЕСТВО(СФ.Ссылка) КАК Количество
        |ИЗ Документ.СчетФактураВыданный КАК СФ
        |ГДЕ СФ.Проведен И НЕ СФ.ПометкаУдаления
        |" + УслКлиент + УслДатаОт + УслДатаДо + УслНеоплач;

    ЗапросКол.УстановитьПараметр("ПустаяДата", '00010101');
    ЗапросКол.УстановитьПараметр("Сегодня", Сегодня);
    Если ЗначениеЗаполнено(КлиентСсылка) Тогда ЗапросКол.УстановитьПараметр("Клиент", КлиентСсылка); КонецЕсли;
    Если ЗначениеЗаполнено(ДатаОт) И ДатаОт <> '00010101' Тогда ЗапросКол.УстановитьПараметр("ДатаОт", ДатаОт); КонецЕсли;
    Если ЗначениеЗаполнено(ДатаДо) И ДатаДо <> '00010101' Тогда ЗапросКол.УстановитьПараметр("ДатаДо", КонецДня(ДатаДо)); КонецЕсли;

    ВыборкаКол = ЗапросКол.Выполнить().Выбрать();
    ВыборкаКол.Следующий();
    Всего = ВыборкаКол.Количество;

    // Основной запрос
    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
        |    СФ.Ссылка                   КАК Ссылка,
        |    СФ.Номер                    КАК Номер,
        |    СФ.Контрагент               КАК Клиент,
        |    СФ.ДоговорКонтрагента       КАК Договор,
        |    СФ.Дата                     КАК ДатаВыставления,
        |    СФ.СрокОплаты               КАК СрокОплаты,
        |    СФ.СуммаДокумента           КАК Сумма,
        |    СФ.СуммаНДС                 КАК СуммаНДС
        |ИЗ
        |    Документ.СчетФактураВыданный КАК СФ
        |ГДЕ
        |    СФ.Проведен
        |    И НЕ СФ.ПометкаУдаления
        |" + УслКлиент + УслДатаОт + УслДатаДо + УслНеоплач
          + "УПОРЯДОЧИТЬ ПО СФ.Дата УБЫВ
        |ПРОПУСТИТЬ " + Формат(Смещение, "ЧГ=0");

    Запрос.УстановитьПараметр("ПустаяДата", '00010101');
    Запрос.УстановитьПараметр("Сегодня", Сегодня);
    Если ЗначениеЗаполнено(КлиентСсылка) Тогда Запрос.УстановитьПараметр("Клиент", КлиентСсылка); КонецЕсли;
    Если ЗначениеЗаполнено(ДатаОт) И ДатаОт <> '00010101' Тогда Запрос.УстановитьПараметр("ДатаОт", ДатаОт); КонецЕсли;
    Если ЗначениеЗаполнено(ДатаДо) И ДатаДо <> '00010101' Тогда Запрос.УстановитьПараметр("ДатаДо", КонецДня(ДатаДо)); КонецЕсли;

    Выборка = Запрос.Выполнить().Выбрать();

    ЗJ = CRMАПИСервер.НачатьОтветJSON();
    ЗJ.ЗаписатьИмяСвойства("data");
    ЗJ.ЗаписатьНачалоМассива();

    Пока Выборка.Следующий() Цикл

        ДнейПросрочки = CRMАПИСервер.ВычислитьДниПросрочки(Выборка.СрокОплаты);
        СрокЗаполнен  = ЗначениеЗаполнено(Выборка.СрокОплаты) И Выборка.СрокОплаты <> '00010101';

        // Статус счёта: NOTE — paid_amount всегда 0 т.к. платежи не привязаны к счетам.
        // Точный расчёт — через /v1/debts (агрегация по клиенту).
        Если ДнейПросрочки > 0 Тогда
            Статус = "OVERDUE";
        ИначеЕсли НЕ СрокЗаполнен Тогда
            Статус = "PENDING";
        Иначе
            Статус = "PENDING";
        КонецЕсли;

        ЗJ.ЗаписатьНачалоОбъекта();

        ЗJ.ЗаписатьИмяСвойства("invoice_id");
        ЗJ.ЗаписатьЗначение(CRMАПИСервер.ФорматГУИД(Выборка.Ссылка));

        ЗJ.ЗаписатьИмяСвойства("invoice_number");
        ЗJ.ЗаписатьЗначение(Выборка.Номер);

        ЗJ.ЗаписатьИмяСвойства("client_id");
        CRMАПИСервер.ЗаписатьГУИД(ЗJ, Выборка.Клиент);

        ЗJ.ЗаписатьИмяСвойства("contract_id");
        CRMАПИСервер.ЗаписатьГУИД(ЗJ, Выборка.Договор);

        ЗJ.ЗаписатьИмяСвойства("amount");
        ЗJ.ЗаписатьЗначение(Выборка.Сумма);

        ЗJ.ЗаписатьИмяСвойства("vat_amount");
        ЗJ.ЗаписатьЗначение(Выборка.СуммаНДС);

        // paid_amount не вычисляется на уровне счёта — используйте /v1/debts
        ЗJ.ЗаписатьИмяСвойства("paid_amount");
        ЗJ.ЗаписатьЗначение(0);

        ЗJ.ЗаписатьИмяСвойства("remaining_balance");
        ЗJ.ЗаписатьЗначение(Выборка.Сумма);

        ЗJ.ЗаписатьИмяСвойства("issue_date");
        CRMАПИСервер.ЗаписатьДату(ЗJ, Выборка.ДатаВыставления);

        ЗJ.ЗаписатьИмяСвойства("due_date");
        CRMАПИСервер.ЗаписатьДату(ЗJ, Выборка.СрокОплаты);

        ЗJ.ЗаписатьИмяСвойства("overdue_days");
        ЗJ.ЗаписатьЗначение(ДнейПросрочки);

        ЗJ.ЗаписатьИмяСвойства("status");
        ЗJ.ЗаписатьЗначение(Статус);

        ЗJ.ЗаписатьКонецОбъекта();

    КонецЦикла;

    ЗJ.ЗаписатьКонецМассива();
    CRMАПИСервер.ЗаписатьПагинацию(ЗJ, Страница, Лимит, Всего);

    Возврат CRMАПИСервер.ОтветУспех(CRMАПИСервер.ЗакрытьОтветJSON(ЗJ));

КонецФункции

// ============================================================
// ЭНДПОИНТ 4: GET /v1/payments
// Шаблон URL: /v1/payments
// ============================================================

Функция ПлатежиПолучить(Запрос) Экспорт

    Если НЕ CRMАПИСервер.ПроверитьАвторизацию(Запрос) Тогда
        Возврат CRMАПИСервер.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    Страница    = CRMАПИСервер.ПолучитьЧисловойПараметр(Запрос, "page",  1,  1, 10000);
    Лимит       = CRMАПИСервер.ПолучитьЧисловойПараметр(Запрос, "limit", 50, 1, 200);
    КлиентИДСтр = CRMАПИСервер.ПолучитьПараметр(Запрос, "client_id", "");
    ДатаОтСтр   = CRMАПИСервер.ПолучитьПараметр(Запрос, "date_from", "");
    ДатаДоСтр   = CRMАПИСервер.ПолучитьПараметр(Запрос, "date_to", "");

    КлиентСсылка = CRMАПИСервер.ГУИДВСсылкуКонтрагента(КлиентИДСтр);
    ДатаОт = CRMАПИСервер.ПарситьДату(ДатаОтСтр);
    ДатаДо = CRMАПИСервер.ПарситьДату(ДатаДоСтр);
    Смещение = (Страница - 1) * Лимит;

    УслКлиент = ?(ЗначениеЗаполнено(КлиентСсылка),   "И Пл.КонтрагентСсылка = &Клиент" + Символы.ПС, "");
    УслДатаОт = ?(ЗначениеЗаполнено(ДатаОт) И ДатаОт <> '00010101', "И Пл.Дата >= &ДатаОт" + Символы.ПС, "");
    УслДатаДо = ?(ЗначениеЗаполнено(ДатаДо) И ДатаДо <> '00010101', "И Пл.Дата <= &ДатаДо" + Символы.ПС, "");

    // ПРИМЕЧАНИЕ: Поле "КонтрагентСсылка" в ПоступлениеНаРасчетныйСчет может называться
    // "Контрагент" или "Плательщик" — проверьте в Конфигураторе.

    ЗапросКол = Новый Запрос;
    ЗапросКол.Текст =
        "ВЫБРАТЬ КОЛИЧЕСТВО(Пл.Ссылка) КАК Количество
        |ИЗ Документ.ПоступлениеНаРасчетныйСчет КАК Пл
        |ГДЕ Пл.Проведен И НЕ Пл.ПометкаУдаления
        |" + УслКлиент + УслДатаОт + УслДатаДо;

    Если ЗначениеЗаполнено(КлиентСсылка) Тогда ЗапросКол.УстановитьПараметр("Клиент", КлиентСсылка); КонецЕсли;
    Если ЗначениеЗаполнено(ДатаОт) И ДатаОт <> '00010101' Тогда ЗапросКол.УстановитьПараметр("ДатаОт", ДатаОт); КонецЕсли;
    Если ЗначениеЗаполнено(ДатаДо) И ДатаДо <> '00010101' Тогда ЗапросКол.УстановитьПараметр("ДатаДо", КонецДня(ДатаДо)); КонецЕсли;

    ВыборкаКол = ЗапросКол.Выполнить().Выбрать();
    ВыборкаКол.Следующий();
    Всего = ВыборкаКол.Количество;

    Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
        |    Пл.Ссылка                          КАК Ссылка,
        |    Пл.КонтрагентСсылка                КАК Клиент,
        |    Пл.ДоговорКонтрагента              КАК Договор,
        |    Пл.СуммаДокумента                  КАК Сумма,
        |    Пл.Дата                             КАК ДатаПлатежа,
        |    Пл.НомерВходящегоДокумента          КАК НомерВходящего,
        |    Пл.НазначениеПлатежа               КАК Назначение
        |ИЗ
        |    Документ.ПоступлениеНаРасчетныйСчет КАК Пл
        |ГДЕ
        |    Пл.Проведен
        |    И НЕ Пл.ПометкаУдаления
        |" + УслКлиент + УслДатаОт + УслДатаДо
          + "УПОРЯДОЧИТЬ ПО Пл.Дата УБЫВ
        |ПРОПУСТИТЬ " + Формат(Смещение, "ЧГ=0");

    Если ЗначениеЗаполнено(КлиентСсылка) Тогда Запрос.УстановитьПараметр("Клиент", КлиентСсылка); КонецЕсли;
    Если ЗначениеЗаполнено(ДатаОт) И ДатаОт <> '00010101' Тогда Запрос.УстановитьПараметр("ДатаОт", ДатаОт); КонецЕсли;
    Если ЗначениеЗаполнено(ДатаДо) И ДатаДо <> '00010101' Тогда Запрос.УстановитьПараметр("ДатаДо", КонецДня(ДатаДо)); КонецЕсли;

    Выборка = Запрос.Выполнить().Выбрать();

    ЗJ = CRMАПИСервер.НачатьОтветJSON();
    ЗJ.ЗаписатьИмяСвойства("data");
    ЗJ.ЗаписатьНачалоМассива();

    Пока Выборка.Следующий() Цикл

        ЗJ.ЗаписатьНачалоОбъекта();

        ЗJ.ЗаписатьИмяСвойства("payment_id");
        ЗJ.ЗаписатьЗначение(CRMАПИСервер.ФорматГУИД(Выборка.Ссылка));

        ЗJ.ЗаписатьИмяСвойства("client_id");
        CRMАПИСервер.ЗаписатьГУИД(ЗJ, Выборка.Клиент);

        ЗJ.ЗаписатьИмяСвойства("contract_id");
        CRMАПИСервер.ЗаписатьГУИД(ЗJ, Выборка.Договор);

        ЗJ.ЗаписатьИмяСвойства("amount");
        ЗJ.ЗаписатьЗначение(Выборка.Сумма);

        ЗJ.ЗаписатьИмяСвойства("payment_date");
        CRMАПИСервер.ЗаписатьДату(ЗJ, Выборка.ДатаПлатежа);

        ЗJ.ЗаписатьИмяСвойства("bank_reference");
        Если ЗначениеЗаполнено(Выборка.НомерВходящего) Тогда
            ЗJ.ЗаписатьЗначение(Выборка.НомерВходящего);
        Иначе
            ЗJ.ЗаписатьЗначение(Неопределено);
        КонецЕсли;

        ЗJ.ЗаписатьИмяСвойства("purpose");
        Если ЗначениеЗаполнено(Выборка.Назначение) Тогда
            ЗJ.ЗаписатьЗначение(Выборка.Назначение);
        Иначе
            ЗJ.ЗаписатьЗначение(Неопределено);
        КонецЕсли;

        ЗJ.ЗаписатьКонецОбъекта();

    КонецЦикла;

    ЗJ.ЗаписатьКонецМассива();
    CRMАПИСервер.ЗаписатьПагинацию(ЗJ, Страница, Лимит, Всего);

    Возврат CRMАПИСервер.ОтветУспех(CRMАПИСервер.ЗакрытьОтветJSON(ЗJ));

КонецФункции

// ============================================================
// ЭНДПОИНТ 5: GET /v1/debts
// Шаблон URL: /v1/debts
// Долг = SUM(счета-фактуры) - SUM(платежи) по каждому клиенту.
// Платежи НЕ привязаны к счетам — агрегируются отдельно.
// ============================================================

Функция ДолгиПолучить(Запрос) Экспорт

    Если НЕ CRMАПИСервер.ПроверитьАвторизацию(Запрос) Тогда
        Возврат CRMАПИСервер.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    Страница    = CRMАПИСервер.ПолучитьЧисловойПараметр(Запрос, "page",  1,  1, 10000);
    Лимит       = CRMАПИСервер.ПолучитьЧисловойПараметр(Запрос, "limit", 50, 1, 200);
    КлиентИДСтр = CRMАПИСервер.ПолучитьПараметр(Запрос, "client_id", "");
    ТолькоСДолгом = CRMАПИСервер.ПолучитьБулевоПараметр(Запрос, "with_debt_only", Истина);

    КлиентСсылка = CRMАПИСервер.ГУИДВСсылкуКонтрагента(КлиентИДСтр);
    Смещение = (Страница - 1) * Лимит;
    Сегодня  = НачалоДня(ТекущаяДата());

    УслКлиент = ?(ЗначениеЗаполнено(КлиентСсылка), "И Контрагенты.Ссылка = &Клиент" + Символы.ПС, "");

    // Пакетный запрос с временными таблицами для эффективного расчёта
    МенеджерВТ = Новый МенеджерВременныхТаблиц;

    // ВТ 1: Счета-фактуры — итого и просрочка по клиентам
    Запрос1 = Новый Запрос;
    Запрос1.МенеджерВременныхТаблиц = МенеджерВТ;
    Запрос1.Текст =
        "ВЫБРАТЬ
        |    СФ.Контрагент                    КАК Клиент,
        |    СУММА(СФ.СуммаДокумента)         КАК ИтогоВыставлено,
        |    СУММА(ВЫБОР
        |        КОГДА СФ.СрокОплаты <> &ПустаяДата
        |             И СФ.СрокОплаты < &Сегодня
        |        ТОГДА СФ.СуммаДокумента
        |        ИНАЧЕ 0
        |    КОНЕЦ)                            КАК ПросрочСумма,
        |    МИНИМУМ(ВЫБОР
        |        КОГДА СФ.СрокОплаты <> &ПустаяДата
        |             И СФ.СрокОплаты < &Сегодня
        |        ТОГДА СФ.СрокОплаты
        |        ИНАЧЕ &МаксДата
        |    КОНЕЦ)                            КАК СтарейшийСрок
        |ПОМЕСТИТЬ ВТСчета
        |ИЗ
        |    Документ.СчетФактураВыданный КАК СФ
        |ГДЕ
        |    СФ.Проведен
        |    И НЕ СФ.ПометкаУдаления
        |СГРУППИРОВАТЬ ПО
        |    СФ.Контрагент
        |;";

    Запрос1.УстановитьПараметр("ПустаяДата", '00010101');
    Запрос1.УстановитьПараметр("Сегодня", Сегодня);
    Запрос1.УстановитьПараметр("МаксДата", '29991231');
    Запрос1.Выполнить();

    // ВТ 2: Платежи — итого по клиентам
    Запрос2 = Новый Запрос;
    Запрос2.МенеджерВременныхТаблиц = МенеджерВТ;
    Запрос2.Текст =
        "ВЫБРАТЬ
        |    Пл.КонтрагентСсылка             КАК Клиент,
        |    СУММА(Пл.СуммаДокумента)        КАК ИтогоОплачено
        |ПОМЕСТИТЬ ВТПлатежи
        |ИЗ
        |    Документ.ПоступлениеНаРасчетныйСчет КАК Пл
        |ГДЕ
        |    Пл.Проведен
        |    И НЕ Пл.ПометкаУдаления
        |СГРУППИРОВАТЬ ПО
        |    Пл.КонтрагентСсылка
        |;";
    Запрос2.Выполнить();

    // ВТ 3: Итог по клиентам
    Запрос3 = Новый Запрос;
    Запрос3.МенеджерВременныхТаблиц = МенеджерВТ;
    Запрос3.Текст =
        "ВЫБРАТЬ
        |    Контрагенты.Ссылка              КАК Ссылка,
        |    Контрагенты.Наименование        КАК Наименование,
        |    Контрагенты.ИНН                 КАК ИНН,
        |    ЕСТЬNULL(ВТСчета.ИтогоВыставлено, 0) КАК ИтогоВыставлено,
        |    ЕСТЬNULL(ВТПлатежи.ИтогоОплачено, 0) КАК ИтогоОплачено,
        |    ЕСТЬNULL(ВТСчета.ПросрочСумма, 0)    КАК ПросрочСумма,
        |    ЕСТЬNULL(ВТСчета.СтарейшийСрок, &ПустаяДата) КАК СтарейшийСрок,
        |    ЕСТЬNULL(ВТСчета.ИтогоВыставлено, 0)
        |        - ЕСТЬNULL(ВТПлатежи.ИтогоОплачено, 0) КАК ОстатокДолга
        |ПОМЕСТИТЬ ВТИтог
        |ИЗ
        |    Справочник.Контрагенты КАК Контрагенты
        |        ЛЕВОЕ СОЕДИНЕНИЕ ВТСчета КАК ВТСчета
        |            ПО ВТСчета.Клиент = Контрагенты.Ссылка
        |        ЛЕВОЕ СОЕДИНЕНИЕ ВТПлатежи КАК ВТПлатежи
        |            ПО ВТПлатежи.Клиент = Контрагенты.Ссылка
        |ГДЕ
        |    НЕ Контрагенты.ПометкаУдаления
        |    И НЕ Контрагенты.ЭтоГруппа
        |" + УслКлиент
          + ?(ТолькоСДолгом,
              "И (ЕСТЬNULL(ВТСчета.ИтогоВыставлено, 0) - ЕСТЬNULL(ВТПлатежи.ИтогоОплачено, 0)) > 0
        |", "")
          + ";";

    Запрос3.УстановитьПараметр("ПустаяДата", '00010101');
    Если ЗначениеЗаполнено(КлиентСсылка) Тогда
        Запрос3.УстановитьПараметр("Клиент", КлиентСсылка);
    КонецЕсли;
    Запрос3.Выполнить();

    // Запрос количества из ВТ
    ЗапросКол = Новый Запрос;
    ЗапросКол.МенеджерВременныхТаблиц = МенеджерВТ;
    ЗапросКол.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(ВТИтог.Ссылка) КАК Количество ИЗ ВТИтог КАК ВТИтог";
    ВыборкаКол = ЗапросКол.Выполнить().Выбрать();
    ВыборкаКол.Следующий();
    Всего = ВыборкаКол.Количество;

    // Финальная выборка с пагинацией
    ЗапросИтог = Новый Запрос;
    ЗапросИтог.МенеджерВременныхТаблиц = МенеджерВТ;
    ЗапросИтог.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
        |    ВТИтог.Ссылка,
        |    ВТИтог.Наименование,
        |    ВТИтог.ИНН,
        |    ВТИтог.ИтогоВыставлено,
        |    ВТИтог.ИтогоОплачено,
        |    ВТИтог.ОстатокДолга,
        |    ВТИтог.ПросрочСумма,
        |    ВТИтог.СтарейшийСрок
        |ИЗ ВТИтог КАК ВТИтог
        |УПОРЯДОЧИТЬ ПО ВТИтог.ОстатокДолга УБЫВ
        |ПРОПУСТИТЬ " + Формат(Смещение, "ЧГ=0");

    Выборка = ЗапросИтог.Выполнить().Выбрать();

    ЗJ = CRMАПИСервер.НачатьОтветJSON();
    ЗJ.ЗаписатьИмяСвойства("data");
    ЗJ.ЗаписатьНачалоМассива();

    Пока Выборка.Следующий() Цикл

        // Дни просрочки по самому старому сроку оплаты
        ДнейПросрочки = CRMАПИСервер.ВычислитьДниПросрочки(Выборка.СтарейшийСрок);
        ОценкаРиска   = CRMАПИСервер.ОценкаРискаПоДням(ДнейПросрочки);

        ЗJ.ЗаписатьНачалоОбъекта();

        ЗJ.ЗаписатьИмяСвойства("client_id");
        ЗJ.ЗаписатьЗначение(CRMАПИСервер.ФорматГУИД(Выборка.Ссылка));

        ЗJ.ЗаписатьИмяСвойства("client_name");
        ЗJ.ЗаписатьЗначение(Выборка.Наименование);

        ЗJ.ЗаписатьИмяСвойства("inn");
        ЗJ.ЗаписатьЗначение(Выборка.ИНН);

        ЗJ.ЗаписатьИмяСвойства("total_invoice_amount");
        ЗJ.ЗаписатьЗначение(Выборка.ИтогоВыставлено);

        ЗJ.ЗаписатьИмяСвойства("total_paid_amount");
        ЗJ.ЗаписатьЗначение(Выборка.ИтогоОплачено);

        ЗJ.ЗаписатьИмяСвойства("total_remaining_debt");
        ЗJ.ЗаписатьЗначение(?(Выборка.ОстатокДолга > 0, Выборка.ОстатокДолга, 0));

        ЗJ.ЗаписатьИмяСвойства("overdue_debt");
        ЗJ.ЗаписатьЗначение(Выборка.ПросрочСумма);

        ЗJ.ЗаписатьИмяСвойства("overdue_days");
        ЗJ.ЗаписатьЗначение(ДнейПросрочки);

        ЗJ.ЗаписатьИмяСвойства("oldest_due_date");
        Если ЗначениеЗаполнено(Выборка.СтарейшийСрок) И Выборка.СтарейшийСрок <> '00010101'
            И Выборка.СтарейшийСрок < '29991231' И ДнейПросрочки > 0 Тогда
            ЗJ.ЗаписатьЗначение(CRMАПИСервер.ФорматДата(Выборка.СтарейшийСрок));
        Иначе
            ЗJ.ЗаписатьЗначение(Неопределено);
        КонецЕсли;

        ЗJ.ЗаписатьИмяСвойства("risk_score");
        ЗJ.ЗаписатьЗначение(ОценкаРиска);

        ЗJ.ЗаписатьКонецОбъекта();

    КонецЦикла;

    ЗJ.ЗаписатьКонецМассива();
    CRMАПИСервер.ЗаписатьПагинацию(ЗJ, Страница, Лимит, Всего);

    Возврат CRMАПИСервер.ОтветУспех(CRMАПИСервер.ЗакрытьОтветJSON(ЗJ));

КонецФункции

// ============================================================
// ЭНДПОИНТ 6: GET /v1/client-financial-summary/{client_id}
// Шаблон URL: /v1/client-financial-summary/{client_id}
// Полное финансовое досье клиента в одном ответе
// ============================================================

Функция ФинансовоеРезюмеПолучить(Запрос) Экспорт

    Если НЕ CRMАПИСервер.ПроверитьАвторизацию(Запрос) Тогда
        Возврат CRMАПИСервер.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    // Параметр из URL-шаблона /v1/client-financial-summary/{client_id}
    КлиентИДСтр = Запрос.ПараметрыURL.Получить("client_id");
    Если НЕ ЗначениеЗаполнено(КлиентИДСтр) Тогда
        Возврат CRMАПИСервер.ОтветОшибки(400, "client_id is required");
    КонецЕсли;

    КлиентСсылка = CRMАПИСервер.ГУИДВСсылкуКонтрагента(КлиентИДСтр);
    Если НЕ ЗначениеЗаполнено(КлиентСсылка) Тогда
        Возврат CRMАПИСервер.ОтветОшибки(404, "Client not found");
    КонецЕсли;

    Сегодня = НачалоДня(ТекущаяДата());

    // --- Блок 1: Данные клиента ---
    ЗапросКлиент = Новый Запрос;
    ЗапросКлиент.Текст =
        "ВЫБРАТЬ
        |    Контрагенты.Ссылка           КАК Ссылка,
        |    Контрагенты.Наименование     КАК Наименование,
        |    Контрагенты.ИНН              КАК ИНН,
        |    КонтТелефон.Представление    КАК Телефон
        |ИЗ
        |    Справочник.Контрагенты КАК Контрагенты
        |        ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтТелефон
        |            ПО КонтТелефон.Объект = Контрагенты.Ссылка
        |            И КонтТелефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
        |ГДЕ
        |    Контрагенты.Ссылка = &Клиент
        |    И НЕ Контрагенты.ПометкаУдаления";
    ЗапросКлиент.УстановитьПараметр("Клиент", КлиентСсылка);
    ВыборкаКлиент = ЗапросКлиент.Выполнить().Выбрать();
    Если НЕ ВыборкаКлиент.Следующий() Тогда
        Возврат CRMАПИСервер.ОтветОшибки(404, "Client not found");
    КонецЕсли;

    // --- Блок 2: Договоры (активные) ---
    ЗапросДоговоры = Новый Запрос;
    ЗапросДоговоры.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 50
        |    Договоры.Ссылка           КАК Ссылка,
        |    Договоры.Номер            КАК Номер,
        |    Договоры.ВидДоговора      КАК ВидДоговора,
        |    Договоры.Дата             КАК ДатаНачала,
        |    Договоры.СрокДействия     КАК СрокДействия,
        |    Договоры.ВалютаВзаиморасчетов КАК Валюта
        |ИЗ
        |    Справочник.ДоговорыКонтрагентов КАК Договоры
        |ГДЕ
        |    Договоры.Владелец = &Клиент
        |    И НЕ Договоры.ПометкаУдаления
        |    И НЕ Договоры.ЭтоГруппа
        |    И (Договоры.СрокДействия = &ПустаяДата
        |       ИЛИ Договоры.СрокДействия >= &Сегодня)
        |УПОРЯДОЧИТЬ ПО Договоры.Дата УБЫВ";
    ЗапросДоговоры.УстановитьПараметр("Клиент", КлиентСсылка);
    ЗапросДоговоры.УстановитьПараметр("ПустаяДата", '00010101');
    ЗапросДоговоры.УстановитьПараметр("Сегодня", Сегодня);
    ВыборкаДоговоры = ЗапросДоговоры.Выполнить().Выбрать();

    // --- Блок 3: Последние 20 счетов-фактур ---
    ЗапросСФ = Новый Запрос;
    ЗапросСФ.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 20
        |    СФ.Ссылка             КАК Ссылка,
        |    СФ.Номер              КАК Номер,
        |    СФ.ДоговорКонтрагента КАК Договор,
        |    СФ.Дата               КАК Дата,
        |    СФ.СрокОплаты         КАК СрокОплаты,
        |    СФ.СуммаДокумента     КАК Сумма,
        |    СФ.СуммаНДС           КАК СуммаНДС
        |ИЗ
        |    Документ.СчетФактураВыданный КАК СФ
        |ГДЕ
        |    СФ.Контрагент = &Клиент
        |    И СФ.Проведен
        |    И НЕ СФ.ПометкаУдаления
        |УПОРЯДОЧИТЬ ПО СФ.Дата УБЫВ";
    ЗапросСФ.УстановитьПараметр("Клиент", КлиентСсылка);
    ВыборкаСФ = ЗапросСФ.Выполнить().Выбрать();

    // --- Блок 4: Последние 20 платежей ---
    ЗапросПл = Новый Запрос;
    ЗапросПл.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 20
        |    Пл.Ссылка                     КАК Ссылка,
        |    Пл.ДоговорКонтрагента         КАК Договор,
        |    Пл.СуммаДокумента             КАК Сумма,
        |    Пл.Дата                        КАК Дата,
        |    Пл.НомерВходящегоДокумента     КАК НомерВходящего
        |ИЗ
        |    Документ.ПоступлениеНаРасчетныйСчет КАК Пл
        |ГДЕ
        |    Пл.КонтрагентСсылка = &Клиент
        |    И Пл.Проведен
        |    И НЕ Пл.ПометкаУдаления
        |УПОРЯДОЧИТЬ ПО Пл.Дата УБЫВ";
    ЗапросПл.УстановитьПараметр("Клиент", КлиентСсылка);
    ВыборкаПл = ЗапросПл.Выполнить().Выбрать();

    // --- Блок 5: Агрегаты долга ---
    МенеджерВТ = Новый МенеджерВременныхТаблиц;

    Запр5а = Новый Запрос;
    Запр5а.МенеджерВременныхТаблиц = МенеджерВТ;
    Запр5а.Текст =
        "ВЫБРАТЬ
        |    СУММА(СФ.СуммаДокумента) КАК ИтогоВыставлено,
        |    СУММА(ВЫБОР
        |        КОГДА СФ.СрокОплаты <> &ПустаяДата
        |             И СФ.СрокОплаты < &Сегодня
        |        ТОГДА СФ.СуммаДокумента
        |        ИНАЧЕ 0
        |    КОНЕЦ) КАК ПросрочСумма,
        |    МИНИМУМ(ВЫБОР
        |        КОГДА СФ.СрокОплаты <> &ПустаяДата
        |             И СФ.СрокОплаты < &Сегодня
        |        ТОГДА СФ.СрокОплаты
        |        ИНАЧЕ &МаксДата
        |    КОНЕЦ) КАК СтарейшийСрок
        |ПОМЕСТИТЬ ВТСчетаКлиента
        |ИЗ
        |    Документ.СчетФактураВыданный КАК СФ
        |ГДЕ
        |    СФ.Контрагент = &Клиент
        |    И СФ.Проведен
        |    И НЕ СФ.ПометкаУдаления";
    Запр5а.УстановитьПараметр("Клиент", КлиентСсылка);
    Запр5а.УстановитьПараметр("ПустаяДата", '00010101');
    Запр5а.УстановитьПараметр("Сегодня", Сегодня);
    Запр5а.УстановитьПараметр("МаксДата", '29991231');
    Запр5а.Выполнить();

    Запр5б = Новый Запрос;
    Запр5б.МенеджерВременныхТаблиц = МенеджерВТ;
    Запр5б.Текст =
        "ВЫБРАТЬ СУММА(Пл.СуммаДокумента) КАК ИтогоОплачено
        |ПОМЕСТИТЬ ВТПлатежиКлиента
        |ИЗ Документ.ПоступлениеНаРасчетныйСчет КАК Пл
        |ГДЕ Пл.КонтрагентСсылка = &Клиент И Пл.Проведен И НЕ Пл.ПометкаУдаления";
    Запр5б.УстановитьПараметр("Клиент", КлиентСсылка);
    Запр5б.Выполнить();

    ЗапросДолг = Новый Запрос;
    ЗапросДолг.МенеджерВременныхТаблиц = МенеджерВТ;
    ЗапросДолг.Текст =
        "ВЫБРАТЬ
        |    ЕСТЬNULL(ВТСчетаКлиента.ИтогоВыставлено, 0) КАК ИтогоВыставлено,
        |    ЕСТЬNULL(ВТПлатежиКлиента.ИтогоОплачено, 0) КАК ИтогоОплачено,
        |    ЕСТЬNULL(ВТСчетаКлиента.ПросрочСумма, 0)    КАК ПросрочСумма,
        |    ЕСТЬNULL(ВТСчетаКлиента.СтарейшийСрок, &ПустаяДата) КАК СтарейшийСрок
        |ИЗ
        |    ВТСчетаКлиента КАК ВТСчетаКлиента,
        |    ВТПлатежиКлиента КАК ВТПлатежиКлиента";
    ЗапросДолг.УстановитьПараметр("ПустаяДата", '00010101');
    ВыборкаДолг = ЗапросДолг.Выполнить().Выбрать();
    ВыборкаДолг.Следующий();

    ИтогоВыставлено = ВыборкаДолг.ИтогоВыставлено;
    ИтогоОплачено   = ВыборкаДолг.ИтогоОплачено;
    ОстатокДолга    = Макс(ИтогоВыставлено - ИтогоОплачено, 0);
    ПросрочСумма    = ВыборкаДолг.ПросрочСумма;
    ДнейПросрочки   = CRMАПИСервер.ВычислитьДниПросрочки(ВыборкаДолг.СтарейшийСрок);
    ОценкаРиска     = CRMАПИСервер.ОценкаРискаПоДням(ДнейПросрочки);

    // --- Сборка JSON ---
    ЗJ = CRMАПИСервер.НачатьОтветJSON();
    ЗJ.ЗаписатьИмяСвойства("data");
    ЗJ.ЗаписатьНачалоОбъекта();

    // -- client --
    ЗJ.ЗаписатьИмяСвойства("client");
    ЗJ.ЗаписатьНачалоОбъекта();
    ЗJ.ЗаписатьИмяСвойства("id");
    ЗJ.ЗаписатьЗначение(CRMАПИСервер.ФорматГУИД(ВыборкаКлиент.Ссылка));
    ЗJ.ЗаписатьИмяСвойства("name");
    ЗJ.ЗаписатьЗначение(ВыборкаКлиент.Наименование);
    ЗJ.ЗаписатьИмяСвойства("inn");
    ЗJ.ЗаписатьЗначение(ВыборкаКлиент.ИНН);
    ЗJ.ЗаписатьИмяСвойства("phone");
    Если ЗначениеЗаполнено(ВыборкаКлиент.Телефон) Тогда
        ЗJ.ЗаписатьЗначение(ВыборкаКлиент.Телефон);
    Иначе
        ЗJ.ЗаписатьЗначение(Неопределено);
    КонецЕсли;
    ЗJ.ЗаписатьКонецОбъекта(); // client

    // -- contracts --
    ЗJ.ЗаписатьИмяСвойства("contracts");
    ЗJ.ЗаписатьНачалоМассива();
    Пока ВыборкаДоговоры.Следующий() Цикл
        Статус = ?(ЗначениеЗаполнено(ВыборкаДоговоры.СрокДействия)
            И ВыборкаДоговоры.СрокДействия <> '00010101'
            И НачалоДня(ВыборкаДоговоры.СрокДействия) < Сегодня, "expired", "active");
        ЗJ.ЗаписатьНачалоОбъекта();
        ЗJ.ЗаписатьИмяСвойства("contract_id");   ЗJ.ЗаписатьЗначение(CRMАПИСервер.ФорматГУИД(ВыборкаДоговоры.Ссылка));
        ЗJ.ЗаписатьИмяСвойства("number");        ЗJ.ЗаписатьЗначение(ВыборкаДоговоры.Номер);
        ЗJ.ЗаписатьИмяСвойства("type");          ЗJ.ЗаписатьЗначение(Строка(ВыборкаДоговоры.ВидДоговора));
        ЗJ.ЗаписатьИмяСвойства("start_date");    CRMАПИСервер.ЗаписатьДату(ЗJ, ВыборкаДоговоры.ДатаНачала);
        ЗJ.ЗаписатьИмяСвойства("end_date");      CRMАПИСервер.ЗаписатьДату(ЗJ, ВыборкаДоговоры.СрокДействия);
        ЗJ.ЗаписатьИмяСвойства("currency");      ЗJ.ЗаписатьЗначение(Строка(ВыборкаДоговоры.Валюта));
        ЗJ.ЗаписатьИмяСвойства("status");        ЗJ.ЗаписатьЗначение(Статус);
        ЗJ.ЗаписатьКонецОбъекта();
    КонецЦикла;
    ЗJ.ЗаписатьКонецМассива(); // contracts

    // -- invoices --
    ЗJ.ЗаписатьИмяСвойства("invoices");
    ЗJ.ЗаписатьНачалоМассива();
    Пока ВыборкаСФ.Следующий() Цикл
        ДнейПросрСФ = CRMАПИСервер.ВычислитьДниПросрочки(ВыборкаСФ.СрокОплаты);
        СтатусСФ = ?(ДнейПросрСФ > 0, "OVERDUE", "PENDING");
        ЗJ.ЗаписатьНачалоОбъекта();
        ЗJ.ЗаписатьИмяСвойства("invoice_id");    ЗJ.ЗаписатьЗначение(CRMАПИСервер.ФорматГУИД(ВыборкаСФ.Ссылка));
        ЗJ.ЗаписатьИмяСвойства("number");        ЗJ.ЗаписатьЗначение(ВыборкаСФ.Номер);
        ЗJ.ЗаписатьИмяСвойства("contract_id");   CRMАПИСервер.ЗаписатьГУИД(ЗJ, ВыборкаСФ.Договор);
        ЗJ.ЗаписатьИмяСвойства("amount");        ЗJ.ЗаписатьЗначение(ВыборкаСФ.Сумма);
        ЗJ.ЗаписатьИмяСвойства("vat_amount");    ЗJ.ЗаписатьЗначение(ВыборкаСФ.СуммаНДС);
        ЗJ.ЗаписатьИмяСвойства("issue_date");    CRMАПИСервер.ЗаписатьДату(ЗJ, ВыборкаСФ.Дата);
        ЗJ.ЗаписатьИмяСвойства("due_date");      CRMАПИСервер.ЗаписатьДату(ЗJ, ВыборкаСФ.СрокОплаты);
        ЗJ.ЗаписатьИмяСвойства("overdue_days");  ЗJ.ЗаписатьЗначение(ДнейПросрСФ);
        ЗJ.ЗаписатьИмяСвойства("status");        ЗJ.ЗаписатьЗначение(СтатусСФ);
        ЗJ.ЗаписатьКонецОбъекта();
    КонецЦикла;
    ЗJ.ЗаписатьКонецМассива(); // invoices

    // -- payments --
    ЗJ.ЗаписатьИмяСвойства("payments");
    ЗJ.ЗаписатьНачалоМассива();
    Пока ВыборкаПл.Следующий() Цикл
        ЗJ.ЗаписатьНачалоОбъекта();
        ЗJ.ЗаписатьИмяСвойства("payment_id");    ЗJ.ЗаписатьЗначение(CRMАПИСервер.ФорматГУИД(ВыборкаПл.Ссылка));
        ЗJ.ЗаписатьИмяСвойства("contract_id");   CRMАПИСервер.ЗаписатьГУИД(ЗJ, ВыборкаПл.Договор);
        ЗJ.ЗаписатьИмяСвойства("amount");        ЗJ.ЗаписатьЗначение(ВыборкаПл.Сумма);
        ЗJ.ЗаписатьИмяСвойства("payment_date");  CRMАПИСервер.ЗаписатьДату(ЗJ, ВыборкаПл.Дата);
        ЗJ.ЗаписатьИмяСвойства("bank_reference");
        Если ЗначениеЗаполнено(ВыборкаПл.НомерВходящего) Тогда
            ЗJ.ЗаписатьЗначение(ВыборкаПл.НомерВходящего);
        Иначе
            ЗJ.ЗаписатьЗначение(Неопределено);
        КонецЕсли;
        ЗJ.ЗаписатьКонецОбъекта();
    КонецЦикла;
    ЗJ.ЗаписатьКонецМассива(); // payments

    // -- debt_summary --
    ЗJ.ЗаписатьИмяСвойства("debt_summary");
    ЗJ.ЗаписатьНачалоОбъекта();
    ЗJ.ЗаписатьИмяСвойства("total_invoiced");  ЗJ.ЗаписатьЗначение(ИтогоВыставлено);
    ЗJ.ЗаписатьИмяСвойства("total_paid");      ЗJ.ЗаписатьЗначение(ИтогоОплачено);
    ЗJ.ЗаписатьИмяСвойства("total_debt");      ЗJ.ЗаписатьЗначение(ОстатокДолга);
    ЗJ.ЗаписатьИмяСвойства("overdue_amount");  ЗJ.ЗаписатьЗначение(ПросрочСумма);
    ЗJ.ЗаписатьИмяСвойства("overdue_days");    ЗJ.ЗаписатьЗначение(ДнейПросрочки);
    ЗJ.ЗаписатьКонецОбъекта(); // debt_summary

    // -- risk_score --
    ЗJ.ЗаписатьИмяСвойства("risk_score");
    ЗJ.ЗаписатьЗначение(ОценкаРиска);

    ЗJ.ЗаписатьКонецОбъекта(); // data

    Возврат CRMАПИСервер.ОтветУспех(CRMАПИСервер.ЗакрытьОтветJSON(ЗJ));

КонецФункции
