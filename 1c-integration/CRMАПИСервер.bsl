// ============================================================
// ОБЩИЙ МОДУЛЬ: CRMАПИСервер
// Свойства: Сервер = Истина; всё остальное = Ложь
// ============================================================

// ------------------------------------------------------------
// РАЗДЕЛ: Авторизация
// ------------------------------------------------------------

// Проверяет HTTP-запрос на наличие корректных учётных данных.
// Поддерживает Basic Auth и Bearer Token.
// Возвращает Истина если авторизован, иначе Ложь.
Функция ПроверитьАвторизацию(Запрос) Экспорт

    Заголовок = Запрос.Заголовки.Получить("Authorization");
    Если Заголовок = Неопределено Тогда
        Заголовок = Запрос.Заголовки.Получить("authorization");
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(Заголовок) Тогда
        Возврат Ложь;
    КонецЕсли;

    // Bearer Token
    Если НачинаетсяС(Заголовок, "Bearer ") Тогда
        Токен = Сред(Заголовок, 8);
        ОжидаемыйТокен = СокрЛП(Строка(Константы.CRMAPIТокен.Получить()));
        Возврат (Токен = ОжидаемыйТокен) И ЗначениеЗаполнено(ОжидаемыйТокен);
    КонецЕсли;

    // Basic Auth
    Если НачинаетсяС(Заголовок, "Basic ") Тогда
        КодированнаяСтрока = Сред(Заголовок, 7);
        Попытка
            ДвоичныеДанные = Base64Значение(КодированнаяСтрока);
            Расшифровано = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные, КодировкаТекста.UTF8);
        Исключение
            Возврат Ложь;
        КонецПопытки;

        ПозДвоеточия = Найти(Расшифровано, ":");
        Если ПозДвоеточия = 0 Тогда
            Возврат Ложь;
        КонецЕсли;

        Логин  = Лев(Расшифровано, ПозДвоеточия - 1);
        Пароль = Сред(Расшифровано, ПозДвоеточия + 1);

        ОжЛогин  = СокрЛП(Строка(Константы.CRMAPIЛогин.Получить()));
        ОжПароль = СокрЛП(Строка(Константы.CRMAPIПароль.Получить()));

        Возврат (Логин = ОжЛогин) И (Пароль = ОжПароль)
            И ЗначениеЗаполнено(ОжЛогин);
    КонецЕсли;

    Возврат Ложь;

КонецФункции

// ------------------------------------------------------------
// РАЗДЕЛ: Построители ответов
// ------------------------------------------------------------

// Возвращает HTTPСервисОтвет с JSON-ошибкой.
Функция ОтветОшибки(КодСтатуса, Сообщение) Экспорт

    Ответ = Новый HTTPСервисОтвет(КодСтатуса);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

    Если КодСтатуса = 401 Тогда
        Ответ.Заголовки.Вставить("WWW-Authenticate", "Basic realm=""CRM API""");
    КонецЕсли;

    ЗJ = Новый ЗаписьJSON;
    ЗJ.УстановитьСтроку();
    ЗJ.ЗаписатьНачалоОбъекта();
    ЗJ.ЗаписатьИмяСвойства("success"); ЗJ.ЗаписатьЗначение(Ложь);
    ЗJ.ЗаписатьИмяСвойства("error");   ЗJ.ЗаписатьЗначение(Сообщение);
    ЗJ.ЗаписатьКонецОбъекта();

    Ответ.УстановитьТелоИзСтроки(ЗJ.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    Возврат Ответ;

КонецФункции

// Возвращает 200 HTTPСервисОтвет с готовой JSON-строкой в теле.
Функция ОтветУспех(ТелоСтрока) Экспорт

    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.Заголовки.Вставить("Cache-Control", "no-cache");
    Ответ.УстановитьТелоИзСтроки(ТелоСтрока, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    Возврат Ответ;

КонецФункции

// ------------------------------------------------------------
// РАЗДЕЛ: JSON-утилиты
// ------------------------------------------------------------

// Создаёт ЗаписьJSON, открывает корневой объект, записывает success:true.
// Возвращает инициализированный объект ЗаписьJSON.
Функция НачатьОтветJSON() Экспорт

    ЗJ = Новый ЗаписьJSON;
    ЗJ.УстановитьСтроку();
    ЗJ.ЗаписатьНачалоОбъекта();
    ЗJ.ЗаписатьИмяСвойства("success");
    ЗJ.ЗаписатьЗначение(Истина);
    Возврат ЗJ;

КонецФункции

// Закрывает корневой объект и возвращает итоговую JSON-строку.
Функция ЗакрытьОтветJSON(ЗJ) Экспорт

    ЗJ.ЗаписатьКонецОбъекта();
    Возврат ЗJ.Закрыть();

КонецФункции

// Записывает блок пагинации: { page, limit, total, totalPages }
Процедура ЗаписатьПагинацию(ЗJ, Страница, Лимит, Всего) Экспорт

    ЗJ.ЗаписатьИмяСвойства("pagination");
    ЗJ.ЗаписатьНачалоОбъекта();
    ЗJ.ЗаписатьИмяСвойства("page");       ЗJ.ЗаписатьЗначение(Страница);
    ЗJ.ЗаписатьИмяСвойства("limit");      ЗJ.ЗаписатьЗначение(Лимит);
    ЗJ.ЗаписатьИмяСвойства("total");      ЗJ.ЗаписатьЗначение(Всего);
    ЗJ.ЗаписатьИмяСвойства("totalPages");
    ЗJ.ЗаписатьЗначение(?(Лимит > 0, Цел((Всего + Лимит - 1) / Лимит), 0));
    ЗJ.ЗаписатьКонецОбъекта();

КонецПроцедуры

// Записывает JSON null если дата не заполнена, иначе ISO 8601.
Процедура ЗаписатьДату(ЗJ, Дата) Экспорт

    Если ЗначениеЗаполнено(Дата) И Дата <> '00010101' Тогда
        ЗJ.ЗаписатьЗначение(Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
    Иначе
        ЗJ.ЗаписатьЗначение(Неопределено);
    КонецЕсли;

КонецПроцедуры

// Записывает GUID ссылки как строку, или null.
Процедура ЗаписатьГУИД(ЗJ, Ссылка) Экспорт

    Если ЗначениеЗаполнено(Ссылка) Тогда
        ЗJ.ЗаписатьЗначение(ФорматГУИД(Ссылка));
    Иначе
        ЗJ.ЗаписатьЗначение(Неопределено);
    КонецЕсли;

КонецПроцедуры

// ------------------------------------------------------------
// РАЗДЕЛ: Форматирование значений
// ------------------------------------------------------------

// Форматирует 1С-ссылку в строку GUID (UUID).
Функция ФорматГУИД(Ссылка) Экспорт

    Возврат НРег(XMLСтрока(Ссылка.УникальныйИдентификатор()));

КонецФункции

// Форматирует дату в ISO 8601. Возвращает пустую строку если дата не заполнена.
Функция ФорматДата(Дата) Экспорт

    Если НЕ ЗначениеЗаполнено(Дата) Или Дата = '00010101' Тогда
        Возврат "";
    КонецЕсли;
    Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");

КонецФункции

// Парсит строку ISO 8601 (yyyy-MM-dd или yyyy-MM-ddTHH:mm:ss) в дату 1С.
// Возвращает '00010101' если строка пустая или некорректная.
Функция ПарситьДату(СтрокаДаты) Экспорт

    Если НЕ ЗначениеЗаполнено(СтрокаДаты) Тогда
        Возврат '00010101';
    КонецЕсли;

    // Нормализуем: убираем суффикс 'Z' и заменяем 'T' пробелом
    Нормал = СтрЗаменить(СтрокаДаты, "T", " ");
    Нормал = СтрЗаменить(Нормал, "Z", "");
    // Обрезаем до 19 символов (yyyy-MM-dd HH:mm:ss)
    Если СтрДлина(Нормал) > 19 Тогда
        Нормал = Лев(Нормал, 19);
    КонецЕсли;

    Попытка
        Возврат ЗначениеИзСтрокиВнутр(Нормал);
    Исключение
        // Попытка через формат даты
        Попытка
            Возврат ДатаВремяМД(Нормал, "yyyy-MM-dd HH:mm:ss");
        Исключение
            Возврат '00010101';
        КонецПопытки;
    КонецПопытки;

КонецФункции

// Конвертирует GUID-строку в ссылку на Справочник.Контрагенты.
// Возвращает ПустаяСсылка() если GUID некорректный или не найден.
Функция ГУИДВСсылкуКонтрагента(СтрокаГУИД) Экспорт

    Если НЕ ЗначениеЗаполнено(СтрокаГУИД) Тогда
        Возврат Справочники.Контрагенты.ПустаяСсылка();
    КонецЕсли;

    Попытка
        УИД = Новый УникальныйИдентификатор(СтрокаГУИД);
        Ссылка = Справочники.Контрагенты.ПолучитьСсылку(УИД);
        // Проверяем что объект существует в базе
        Если ЗначениеЗаполнено(Ссылка.Наименование) Тогда
            Возврат Ссылка;
        КонецЕсли;
        Возврат Справочники.Контрагенты.ПустаяСсылка();
    Исключение
        Возврат Справочники.Контрагенты.ПустаяСсылка();
    КонецПопытки;

КонецФункции

// ------------------------------------------------------------
// РАЗДЕЛ: Параметры запроса
// ------------------------------------------------------------

// Возвращает значение параметра URL-запроса или значение по умолчанию.
Функция ПолучитьПараметр(Запрос, Имя, Умолчание = Неопределено) Экспорт

    Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
    Если Значение = Неопределено Или СокрЛП(Значение) = "" Тогда
        Возврат Умолчание;
    КонецЕсли;
    Возврат СокрЛП(Значение);

КонецФункции

// Возвращает числовой параметр с проверкой диапазона.
Функция ПолучитьЧисловойПараметр(Запрос, Имя, Умолчание, Мин, Макс) Экспорт

    СтрЗнач = ПолучитьПараметр(Запрос, Имя, "");
    Если СтрЗнач = "" Тогда
        Возврат Умолчание;
    КонецЕсли;
    Попытка
        Число = Число(СтрЗнач);
        Возврат Мин(Макс(Число, Мин), Макс);
    Исключение
        Возврат Умолчание;
    КонецПопытки;

КонецФункции

// Возвращает булево значение параметра ("true"/"1" → Истина).
Функция ПолучитьБулевоПараметр(Запрос, Имя, Умолчание = Ложь) Экспорт

    Знач = НРег(СокрЛП(ПолучитьПараметр(Запрос, Имя, "")));
    Если Знач = "true" Или Знач = "1" Тогда
        Возврат Истина;
    ИначеЕсли Знач = "false" Или Знач = "0" Тогда
        Возврат Ложь;
    Иначе
        Возврат Умолчание;
    КонецЕсли;

КонецФункции

// Вычисляет количество дней просрочки относительно сегодня.
// Возвращает 0 если дата не указана или срок не наступил.
Функция ВычислитьДниПросрочки(ДатаОплаты) Экспорт

    Если НЕ ЗначениеЗаполнено(ДатаОплаты) Или ДатаОплаты = '00010101' Тогда
        Возврат 0;
    КонецЕсли;
    Сегодня = НачалоДня(ТекущаяДата());
    СрокДата = НачалоДня(ДатаОплаты);
    Если СрокДата >= Сегодня Тогда
        Возврат 0;
    КонецЕсли;
    Возврат Цел((Сегодня - СрокДата) / 86400);

КонецФункции

// Определяет уровень риска по количеству дней просрочки.
Функция ОценкаРискаПоДням(ДнейПросрочки) Экспорт

    Если ДнейПросрочки = 0 Тогда
        Возврат "LOW";
    ИначеЕсли ДнейПросрочки <= 15 Тогда
        Возврат "MEDIUM";
    ИначеЕсли ДнейПросрочки <= 30 Тогда
        Возврат "HIGH";
    Иначе
        Возврат "CRITICAL";
    КонецЕсли;

КонецФункции
