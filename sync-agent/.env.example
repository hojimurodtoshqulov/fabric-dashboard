# ── Fabric Automation API ─────────────────────────────────────────────────────
# URL of your deployed Fabric Automation app (Vercel)
FABRIC_API_URL=https://your-app.vercel.app

# Secret key — must match ONEC_SYNC_SECRET in Vercel env vars
FABRIC_SYNC_KEY=your-super-secret-sync-key-here

# ── 1C Connection ─────────────────────────────────────────────────────────────
# Mode: "file" (file base on local disk) or "server" (1C server)
ONEC_MODE=file

# File mode: full path to 1C infobase folder
ONEC_FILE_PATH=C:\Users\user\1C\Bases\SelxozmashTextil

# Server mode (only if ONEC_MODE=server):
# ONEC_SERVER=192.168.1.100
# ONEC_BASE=SelxozmashBase

# 1C login credentials
ONEC_USER=Admin
ONEC_PASSWORD=

# ── Sync settings ─────────────────────────────────────────────────────────────
# How many days back to sync sales invoices (default: 90)
SYNC_DAYS=90
